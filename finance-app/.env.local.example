# ---------- Supabase ----------
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Auth allowlist ----------
# Only this email address is allowed to log in. Comma-separate for multiple.
ALLOWED_EMAILS=you@yourdomain.com

# ---------- Plaid ----------
# Sandbox: https://dashboard.plaid.com -> Team Settings -> Keys
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox
# Comma-separated. Add 'transactions' for the MVP.
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# 730 = max history (2 years) per Plaid docs
PLAID_DAYS_REQUESTED=730
# Webhook URL Plaid will POST to. Use ngrok in dev or your Vercel URL in prod.
PLAID_WEBHOOK_URL=https://your-app.vercel.app/api/plaid/sync

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# A long random string used to authorize the cron sync endpoint
CRON_SECRET=generate-a-long-random-string-here

# ---------- Claude (Phase 5, not used yet) ----------
# ANTHROPIC_API_KEY=
